# --- Evolution API ---
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-por-uma-chave-aleatoria
EVOLUTION_INSTANCE=agrobot

# --- Quem pode conversar com o bot ---
# Formato: 55 + DDD + número, sem + nem espaços. Vários números separados por vírgula.
ALLOWED_NUMBERS=5511999999999

# --- Logs (DEBUG, INFO, WARNING, ERROR) ---
LOG_LEVEL=INFO

# --- Pipeline de teste (mocks): controla o que o bot responde às fotos ---
# Pragas: lagarta-do-cartucho | lagarta-da-espiga | vaquinha | milho-saudavel
MOCK_PRAGA=lagarta-do-cartucho

# >= 0.80 diagnóstico direto | 0.50 a 0.79 pede outra foto | < 0.50 Casa da Agricultura
MOCK_CONFIANCA=0.85

# false simula foto de má qualidade
MOCK_FOTO_OK=true
