# --- Evolution API ---
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-por-uma-chave-aleatoria
EVOLUTION_INSTANCE=agrobot

# --- Quem pode conversar com o bot ---
# Formato: 55 + DDD + número, sem + nem espaços. Vários números separados por vírgula.
ALLOWED_NUMBERS=5511999999999

# --- Logs (DEBUG, INFO, WARNING, ERROR) ---
LOG_LEVEL=INFO

# --- Anthropic (Claude Haiku só redige a resposta a partir da ficha) ---
# Sem a chave, o bot cai numa resposta mecânica tirada da própria ficha.
ANTHROPIC_API_KEY=
